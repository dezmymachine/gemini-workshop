# Copy this file to .env and fill in the values from Supabase:
# Project Settings -> API Keys (or API)
# On Vercel, add these same three names under Settings -> Environment Variables.

# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# anon / publishable key (safe for the browser)
SUPABASE_ANON_KEY=

# service_role / secret key (PRIVATE: never commit or share)
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Resend): every message to students ---
RESEND_API_KEY=
MAIL_FROM="Gemini Workshop <workshop@kecworkshops.com>"
# Optional: where replies go (default: the From address)
MAIL_REPLY_TO=
# Any long random text. Vercel sends it with the daily job so nobody else can trigger it.
CRON_SECRET=
# Local testing only: MAIL_TRANSPORT=json prints emails to the log instead of sending
MAIL_TRANSPORT=

# --- Optional fallback: Amazon SES over SMTP (used only when RESEND_API_KEY is empty, or MAIL_PROVIDER=smtp) ---
# SMTP_HOST=email-smtp.eu-west-1.amazonaws.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_PROVIDER=smtp
# Bounce/complaint webhook from SES (SNS): /api/mail-events?key=SES_EVENTS_SECRET
SES_EVENTS_SECRET=
SES_TOPIC_ARN=
