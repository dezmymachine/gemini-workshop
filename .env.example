# Copy this file to .env and fill in the values from Supabase:
# Project Settings -> API Keys (or API)
# On Vercel, add these same three names under Settings -> Environment Variables.

# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=

# anon / publishable key (safe for the browser)
SUPABASE_ANON_KEY=

# service_role / secret key (PRIVATE: never commit or share)
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Amazon SES SMTP): students with Gmail, Yahoo, Outlook, iCloud... ---
SMTP_HOST=email-smtp.eu-west-1.amazonaws.com
SMTP_PORT=587
# SES -> SMTP settings -> Create SMTP credentials (not the AWS access key)
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Gemini Workshop <workshop@kecworkshops.com>
# Long random text; part of the SNS subscription URL /api/mail-events?key=...
SES_EVENTS_SECRET=
# Optional: only accept bounce/complaint messages from this SNS topic
SES_TOPIC_ARN=
# Optional: replaces the built-in list of email domains that get email (comma list)
EMAIL_DOMAINS=
# Local testing only: MAIL_TRANSPORT=json prints emails to the log instead of sending
MAIL_TRANSPORT=

# --- SMS (mNotify, https://mnotify.com): school addresses and bounced emails ---
# API key from the mNotify dashboard
MNOTIFY_API_KEY=
# Sender ID registered in mNotify (11 characters at most, not a phone number). Leave empty to use "mNotify".
MNOTIFY_SENDER=
# Any long random text. Vercel sends it with the daily reminder job so nobody else can trigger it.
CRON_SECRET=
